{
  "name": "delegate-game-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DELEGATE - a social grand-strategy prototype about losing votes",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
