{
  "name": "delegate-game-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DELEGATE - a social grand-strategy prototype about losing votes",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "check": "tsc -b && vitest run && vite build && npm run bundle",
    "sim": "vite-node src/game/sim.ts",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=play.mjs --banner:js='#!/usr/bin/env node'",
    "play": "node play.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
